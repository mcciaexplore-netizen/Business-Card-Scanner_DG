# Gemini API key - required for both card extraction and bulk card
# detection (bounding boxes).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional RapidOCR/OpenCV sidecar. Leave blank to deploy with Gemini fallbacks.
# For local use: http://127.0.0.1:8000. Production requires a hosted HTTPS URL.
OCR_SERVICE_URL=

# Google Apps Script Web App URL (see apps-script/Code.gs + README).
# Looks like: https://script.google.com/macros/s/AKfycb.../exec
APPS_SCRIPT_URL=

# Must exactly match the SHARED_SECRET value inside apps-script/Code.gs
APPS_SCRIPT_SECRET=change-this-to-a-long-random-secret

# Max upload size in MB
MAX_UPLOAD_MB=18
